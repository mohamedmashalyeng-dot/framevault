# ---------------------------------------------------------------------------
# FRAMEVAULT environment. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# development | test | staging | production
APP_ENV=development
# Public base URL of the store (used for auth callbacks, checkout return URLs, sitemap).
APP_URL=http://localhost:3000
# Better Auth reads this too; keep it equal to APP_URL.
BETTER_AUTH_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Local SQLite file (default) or a libSQL/Turso URL such as libsql://your-db.turso.io
DATABASE_URL=file:./data/framevault.db
# Only for remote libSQL/Turso databases.
DATABASE_AUTH_TOKEN=

# --- Secrets (generate each with: openssl rand -base64 48) -------------------
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DOWNLOAD_TOKEN_SECRET=replace-with-a-different-32-plus-character-secret

# --- Storage ----------------------------------------------------------------
# Private files (archives), demo bundles, media renditions and the dev outbox.
STORAGE_DIR=./storage
# Optional separate origin for sandboxed demos in production, e.g. https://demos.example.com
# (that host must route /demo/* to this app). Leave empty to serve demos from APP_URL.
DEMO_ORIGIN=

# --- Store ------------------------------------------------------------------
STORE_CURRENCY=USD
# true labels prices as "Demo pricing" across the store (local development).
DEMO_PRICING=true
# Optional brand overrides (FRAMEVAULT is a placeholder name).
NEXT_PUBLIC_BRAND_NAME=FRAMEVAULT
NEXT_PUBLIC_SUPPORT_EMAIL=support@framevault.local

# --- Payments ---------------------------------------------------------------
# simulated: local-only fake provider (refused when APP_ENV=production)
# stripe:    Stripe Checkout (use sk_test_ keys outside production)
PAYMENT_PROVIDER=simulated
SIMULATED_WEBHOOK_SECRET=replace-with-another-32-plus-character-secret
STRIPE_SECRET_KEY=
# Signing secret of your webhook endpoint (or the one printed by `stripe listen`).
STRIPE_WEBHOOK_SECRET=

# --- Email ------------------------------------------------------------------
# Without RESEND_API_KEY, non-production emails go to storage/outbox (see /dev/outbox).
EMAIL_FROM=FRAMEVAULT <no-reply@framevault.local>
RESEND_API_KEY=

# --- Seed accounts (npm run db:seed) ------------------------------------------
SEED_ADMIN_EMAIL=admin@framevault.local
SEED_ADMIN_PASSWORD=choose-a-strong-admin-password
SEED_CUSTOMER_EMAIL=customer@framevault.local
SEED_CUSTOMER_PASSWORD=choose-a-customer-password
